<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.skillshield</groupId>
    <artifactId>skillshield-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>skillshield-app</artifactId>
  <packaging>jar</packaging>

  <name>SkillShield App</name>

  <dependencies>
    <dependency>
      <groupId>de.skillshield</groupId>
      <artifactId>skillshield-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>de.skillshield</groupId>
      <artifactId>skillshield-io</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>de.skillshield</groupId>
      <artifactId>skillshield-vault</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>de.skillshield</groupId>
      <artifactId>skillshield-ui</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!-- Die startbare JAR heisst skillshield.jar (OF-1); Shade ersetzt sie in package durch die Fassung mit allem. -->
    <finalName>skillshield</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.awt.headless>${ui.headless}</java.awt.headless>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <!-- Normaler Lauf in "test": ohne die *IT-Klassen, die die fertige JAR brauchen. -->
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/*IT.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <!-- Zweiter Lauf nach "package": Tests, die skillshield.jar in einer zweiten JVM starten (AK-1, AK-44, AK-51). -->
          <execution>
            <id>jar-tests</id>
            <phase>integration-test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <systemPropertyVariables>
                <java.awt.headless>${ui.headless}</java.awt.headless>
                <skillshield.jar>${project.build.directory}/skillshield.jar</skillshield.jar>
                <skillshield.cmd>${project.build.directory}/SkillShield.cmd</skillshield.cmd>
                <skillshield.testclasses>${project.build.testOutputDirectory}</skillshield.testclasses>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>startbare-jar</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Signaturreste und Modulbeschreibungen (auch die mehrfachversionierten) gehoeren nicht hinein -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>com.formdev:flatlaf</artifact>
                  <excludes>
                    <!-- Native Bibliotheken: FlatLaf wuerde sie auf die Platte entpacken (AK-44); der Start schaltet
                         sie ab, deshalb gehoeren sie nicht in die JAR. -->
                    <exclude>com/formdev/flatlaf/natives/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Main-Class>de.skillshield.app.SkillShieldApp</Main-Class>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <!-- Bewusst ohne ApacheLicense-/ApacheNotice-Transformer: Der Lizenz-Transformer verwirft jede
                     META-INF/LICENSE (die Lizenz von FlatLaf ginge verloren), der Notice-Transformer erzeugt ohne
                     NOTICE-Quelle eine leere Datei. FlatLaf liefert META-INF/LICENSE, aber keine NOTICE-Datei. -->
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <!-- SkillShield.cmd (Doppelklick-Start) kommt neben die JAR -->
          <execution>
            <id>startskript-kopieren</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/start</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>positivliste</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>de.skillshield:skillshield-core</include>
                    <include>de.skillshield:skillshield-io</include>
                    <include>de.skillshield:skillshield-vault</include>
                    <include>de.skillshield:skillshield-ui</include>
                    <include>com.formdev:flatlaf:${flatlaf.version}</include>
                    <include>org.junit.jupiter:*:*:*:test</include>
                    <include>org.junit.platform:*:*:*:test</include>
                    <include>org.opentest4j:*:*:*:test</include>
                    <include>org.apiguardian:*:*:*:test</include>
                  </includes>
                  <searchTransitive>true</searchTransitive>
                  <message>Positivliste verletzt (AK-52): skillshield-app darf nur SkillShield-Module, FlatLaf und die JUnit-Familie einbinden.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
