<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.skillshield</groupId>
    <artifactId>skillshield-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>skillshield-ui</artifactId>
  <packaging>jar</packaging>

  <name>SkillShield UI</name>

  <dependencies>
    <dependency>
      <groupId>de.skillshield</groupId>
      <artifactId>skillshield-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>de.skillshield</groupId>
      <artifactId>skillshield-io</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>de.skillshield</groupId>
      <artifactId>skillshield-vault</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Synthetische KV-Nummern des Kerns (SynthetischeKvNummern) fuer die Oberflaechentests (A-1) -->
    <dependency>
      <groupId>de.skillshield</groupId>
      <artifactId>skillshield-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.awt.headless>${ui.headless}</java.awt.headless>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>positivliste</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>de.skillshield:skillshield-core</include>
                    <include>de.skillshield:skillshield-io</include>
                    <include>de.skillshield:skillshield-vault</include>
                    <include>org.junit.jupiter:*:*:*:test</include>
                    <include>org.junit.platform:*:*:*:test</include>
                    <include>org.opentest4j:*:*:*:test</include>
                    <include>org.apiguardian:*:*:*:test</include>
                  </includes>
                  <searchTransitive>true</searchTransitive>
                  <message>Positivliste verletzt (AK-52): skillshield-ui darf nur SkillShield-Module und die JUnit-Familie einbinden.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>modulrichtung</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>de.skillshield:skillshield-app</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                  <message>Modulrichtung verletzt (Plan.md Kap. 5): skillshield-ui darf nur von skillshield-core, skillshield-io und skillshield-vault abhängen, nicht von skillshield-app.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
